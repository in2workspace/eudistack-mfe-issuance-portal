{
  "$schema": "./node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.25.0",
    "useDocker": true,
    "generators": {
      "journey": {
        "generatorName": "typescript-angular",
        "inputSpec": "#{cwd}/api/journey.openapi.yaml",
        "output": "#{cwd}/src/app/core/api/generated/journey",
        "additionalProperties": {
          "ngVersion": "19.0.0",
          "providedIn": "root",
          "apiModulePrefix": "Journey",
          "configurationPrefix": "Journey",
          "serviceSuffix": "Api",
          "fileNaming": "kebab-case",
          "supportsES6": true
        }
      },
      "authentic-source": {
        "generatorName": "typescript-angular",
        "inputSpec": "#{cwd}/api/authentic-source.openapi.yaml",
        "output": "#{cwd}/src/app/core/api/generated/authentic-source",
        "additionalProperties": {
          "ngVersion": "19.0.0",
          "providedIn": "root",
          "apiModulePrefix": "AuthenticSource",
          "configurationPrefix": "AuthenticSource",
          "serviceSuffix": "Api",
          "fileNaming": "kebab-case",
          "supportsES6": true
        }
      }
    }
  }
}
